# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=mono_store

# Stripe (required for checkout — get a test key from dashboard.stripe.com)
STRIPE_API_KEY=sk_test_your_key_here

# Comma-separated list of origins allowed to call this API with credentials.
# No wildcards — CORS + cookies requires an explicit origin.
CORS_ORIGINS=http://localhost:3000

# Used to build Stripe success/cancel redirect URLs when the request has no Origin header.
FRONTEND_URL=http://localhost:3000

# Set to "false" only for local HTTP development. Keep "true" in production (HTTPS).
COOKIE_SECURE=true
